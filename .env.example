# ───────────── 湾谷园区综合运营工作台 · 后端环境变量 ─────────────
# 复制为 .env 后按需修改；启动时若存在 .env 会自动加载（已存在的系统环境变量优先）。

# 监听端口与地址（生产由 Caddy 反代 HTTPS，建议只监听 127.0.0.1）
PORT=3300
HOST=127.0.0.1

# 数据目录：SQLite 数据库 wangu.db 存放于此（相对路径基于启动时的工作目录）
DATA_DIR=./data

# 登录密码；留空则关闭鉴权（仅限本地开发！）
AUTH_PASSWORD=
AUTH_SECRET=            # cookie 签名密钥，留空则由 AUTH_PASSWORD 派生
# COOKIE_SECURE=true    # Cookie 是否带 Secure；默认 NODE_ENV=production 时为 true
# NODE_ENV=production
# LOG_LEVEL=info        # fastify 日志级别：fatal|error|warn|info|debug|trace

# ───────────── 飞书多维表格 ─────────────
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=
FEISHU_BASE_TOKEN=FHbvbqfybap1U1sWSNOcZQlvnqh
FEISHU_TABLE_DAILY=tbl4m7w4tlwyI9j2   # 日常维修总表
FEISHU_TABLE_LEGACY=tbl27kc7E8IQEEj0  # 施工遗留专项表
FEISHU_BASE_URL=https://open.feishu.cn

# 同步调度
SYNC_CRON=15 6 * * *     # 每天 06:15（Asia/Shanghai）
SYNC_INTERVAL_MINUTES=0  # >0 时额外按间隔同步

# ───────────── 能耗（nenghao 只读代理） ─────────────
NENGHAO_API_BASE=http://127.0.0.1:3100
SOLAR_API_URL=           # 留空则用 ${NENGHAO_API_BASE}/api/solar

# 数据模式：auto（飞书凭证未配置/为占位值时用模拟数据）| live（强制真实数据）| mock（强制模拟数据）
DATA_MODE=auto           # auto | live | mock
